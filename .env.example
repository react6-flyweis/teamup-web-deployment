# ==========================================
# Team Up Arena - Frontend Environment Variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# ==========================================

# Backend API Base URL (used in axios client and site content hooks)
# Note: Trailing slash is automatically trimmed by the app if present
VITE_API_BASE=https://api.teamuparena.com/

# External booking / pass purchase platform URL (used in constants.js)
# Defaults to '/coming-soon' if unset
VITE_BOOKING_URL=

# (Optional) Google Maps Embed API Key (used in mapUtils.js)
# If omitted or left empty, map embeds will automatically use a keyless fallback
VITE_GOOGLE_MAPS_API_KEY=
